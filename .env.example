# Copy to .env (server) and fill in. Never commit the real file.
# Frontend values (NEXT_PUBLIC_*) go in apps/web/.env.local.

# ---------- LiveKit (phase 2) ----------
# LiveKit Cloud free tier or self-hosted. Used by the agent and the token endpoint.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ---------- Frontend (phase 2) -> apps/web/.env.local ----------
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---------- GPU server: PersonaPlex (phase 1) ----------
# PersonaPlex weights are gated: accept the license on Hugging Face, then create a read token.
HF_TOKEN=hf_your-read-token
PERSONAPLEX_MODEL=nvidia/personaplex-7b-v1
PERSONA_PROMPT_PATH=prompts/persona.md
PERSONAPLEX_VOICE_PATH=server/personaplex/voices/lumi.wav

# ---------- Supabase (phase 4) ----------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose to the browser
