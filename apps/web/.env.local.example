# Copy to apps/web/.env.local and fill in from your LiveKit Cloud project
# (Settings -> Keys). Never commit .env.local.
#
# These are server-only (no NEXT_PUBLIC_ prefix): /api/token reads them to create
# room tokens, and the secret never reaches the browser. The token response
# includes LIVEKIT_URL, so the browser doesn't need it as an env var.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
